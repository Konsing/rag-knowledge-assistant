# LLM Generation — set provider to "openai" or "claude"
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# For Qdrant Cloud, set URL/key and switch EMBEDDING_PROVIDER below.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_CLOUD_INFERENCE=false
COLLECTION_NAME=research_papers
DATA_DIR=/app/data

# "local" uses sentence-transformers in this container. "qdrant_cloud" uses
# Qdrant's hosted free all-MiniLM inference and supports the slim demo image.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Parameters
TOP_K=5
SCORE_THRESHOLD=0.3

# Safety limits (bytes)
MAX_UPLOAD_BYTES=26214400
MAX_WEB_BYTES=5242880
MAX_PDF_BYTES=52428800

# Optional local API protection. If enabled, set both values to the same key.
APP_API_KEY=
VITE_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public showcase. Copy this template to the repository-root .env, then change
# DEMO_MODE to true. It requires ADMIN_API_KEY and makes normal queries public
# while keeping ingestion and seeding behind X-Admin-Key. Render sets it from
# render.yaml instead; do not set DEMO_MODE in Vercel.
DEMO_MODE=false
DEMO_AUTO_SEED=false
DEMO_DOCUMENTS_FILE=demo_documents.json
ADMIN_API_KEY=
DEMO_QUERIES_PER_HOUR=10
DEMO_QUERIES_PER_DAY=50
DEMO_MAX_QUESTION_CHARS=500
DEMO_CACHE_SIZE=100
DEMO_MAX_SELECTED_DOCUMENTS=5

# Optional hCaptcha Basic protection for the anonymous query form.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Set this in Vercel to the public Render API URL, including /api.
VITE_API_BASE_URL=

# MCP Server
MCP_PORT=8811
