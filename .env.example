# LLM Generation — set provider to "openai" or "claude"
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=research_papers
DATA_DIR=/app/data

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Parameters
TOP_K=5
SCORE_THRESHOLD=0.3

# Safety limits (bytes)
MAX_UPLOAD_BYTES=26214400
MAX_WEB_BYTES=5242880
MAX_PDF_BYTES=52428800

# Optional local API protection. If enabled, set both values to the same key.
APP_API_KEY=
VITE_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP Server
MCP_PORT=8811
